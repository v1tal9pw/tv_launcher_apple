<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settings_backdrop"
    android:orientation="horizontal"
    android:paddingStart="48dp"
    android:paddingEnd="40dp"
    android:paddingTop="36dp"
    android:paddingBottom="32dp"
    android:clipChildren="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="264dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="40dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launcher_brand"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_equalizer"
            android:textColor="#FFFFFFFF"
            android:textSize="36sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.035" />

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <com.gathin.tvhome.EqualizerCurveView
            android:id="@+id/equalizerCurve"
            android:layout_width="match_parent"
            android:layout_height="148dp"
            android:background="@drawable/settings_preview_bg"
            android:clipToOutline="true"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/equalizerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#A6FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif" />

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <TextView
            android:id="@+id/equalizerDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#F2FFFFFF"
            android:textSize="17sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/equalizerDetailHint"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="8dp"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="3sp"
            android:maxLines="4"
            android:ellipsize="end" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/equalizerScroll"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:padding="16dp"
        android:clipChildren="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView style="@style/SettingsSection" android:text="@string/equalizer_section_main" />
            <LinearLayout style="@style/SettingsGroup">
                <com.gathin.tvhome.SettingsRowView
                    android:id="@+id/equalizerToggle"
                    style="@style/SettingsRow"
                    android:text="@string/equalizer_enable" />
                <View style="@style/SettingsDivider" />
                <com.gathin.tvhome.SettingsRowView
                    android:id="@+id/equalizerPreset"
                    style="@style/SettingsRow"
                    android:text="@string/equalizer_preset" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/equalizerZonesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false" />

            <TextView
                style="@style/SettingsSection"
                android:layout_marginTop="22dp"
                android:text="@string/equalizer_section_extra" />
            <LinearLayout
                android:id="@+id/equalizerExtraGroup"
                style="@style/SettingsGroup">
                <com.gathin.tvhome.SettingsRowView
                    android:id="@+id/equalizerReset"
                    style="@style/SettingsRow"
                    android:text="@string/equalizer_reset" />
                <View
                    android:id="@+id/equalizerSystemDivider"
                    style="@style/SettingsDivider"
                    android:visibility="gone" />
                <com.gathin.tvhome.SettingsRowView
                    android:id="@+id/equalizerSystemPanel"
                    style="@style/SettingsRow"
                    android:text="@string/equalizer_system_panel"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
